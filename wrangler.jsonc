{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editorstuff",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "routes": [
    {
      "pattern": "cutefish.my.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
