{
  "name": "editorstuff",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "cutefish.my.id",
      "custom_domain": true
    },
    {
      "pattern": "www.cutefish.my.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
