/*
  Cross-Origin-Opener-Policy: same-origin

  NOTE: TANPA Cross-Origin-Embedder-Policy di sini — COEP credentialless global
  memblokir iframe lintas-origin (mis. embed YouTube tutorial). Halaman yang
  butuh cross-origin isolation memakai coi-serviceworker.min.js.

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/coi-serviceworker.min.js
  Service-Worker-Allowed: /
  Cache-Control: no-cache, must-revalidate

/api/version
  Cache-Control: no-cache, no-store, must-revalidate

/assets/models/*
  Cache-Control: public, max-age=31536000, immutable

/assets/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable

/assets/ffmpeg/ffmpeg-loader.js
  Cache-Control: no-cache, must-revalidate

/assets/icon/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/svg/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/upscale/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/jszip/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=3600, must-revalidate

/scripts/*
  Cache-Control: no-cache, must-revalidate

/styles/*
  Cache-Control: no-cache, must-revalidate
