{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/realesrgan/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "status": 302,
      "headers": {
        "Location": "https://cutefish.my.id/$1"
      }
    }
  ]
}
